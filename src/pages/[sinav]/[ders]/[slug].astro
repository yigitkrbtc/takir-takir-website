---
// Konu sayfası: bölüm sırası src/lib/bolumler.ts, her bölüm kendi bileşeninde (src/components/konu/).
import Base from '../../../layouts/Base.astro';
import Metin from '../../../components/Metin.astro';
import TerimPenceleri from '../../../components/TerimPenceleri.astro';
import Bolum from '../../../components/konu/Bolum.astro';
import Gorsel from '../../../components/konu/Gorsel.astro';
import KuralKart from '../../../components/konu/KuralKart.astro';
import NedenListe from '../../../components/konu/NedenListe.astro';
import HataKart from '../../../components/konu/HataKart.astro';
import Sorular from '../../../components/konu/Sorular.astro';
import VideoKart from '../../../components/konu/VideoKart.astro';
import DersSonu from '../../../components/konu/DersSonu.astro';
import Kaynaklar from '../../../components/konu/Kaynaklar.astro';
import Tahmin from '../../../components/islands/Tahmin.tsx';
import Ornek from '../../../components/islands/Ornek.tsx';
import Kartlar from '../../../components/islands/Kartlar.tsx';
import {tumKonular, ogYolu} from '../../../lib/konular';
import {konuBolumleri} from '../../../lib/bolumler';
import {SITE_ADI} from '../../../lib/site';
import {kirinti, konuJsonld} from '../../../lib/seo';
import {dersYolu, konuUrl, sinavYolu} from '../../../konu/yol';
import type {Konu} from '../../../konu/schema';
import '../../../styles/ada.css';
import '../../../styles/konu.css';

export async function getStaticPaths() {
  const hepsi = await tumKonular();
  return hepsi.map((k) => ({params: {sinav: k.sinav.toLowerCase(), ders: k.dersSlug, slug: k.slug}, props: {k, hepsi}}));
}

const {k, hepsi} = Astro.props as {k: Konu; hepsi: Konu[]};
const site = Astro.site!;
const adlar = k.terimler.map((t) => t.ad);
const bolumler = konuBolumleri(k);
const b = Object.fromEntries(bolumler.map((x) => [x.id, x]));
const kirintiOgeleri = [
  {ad: SITE_ADI, yol: '/'},
  {ad: k.sinav, yol: sinavYolu(k.sinav)},
  {ad: `${k.sinav} ${k.ders}`, yol: dersYolu(k)},
  {ad: k.konu, yol: konuUrl(k)},
];
---

<Base baslik={`${k.baslik} | ${SITE_ADI}`} aciklama={k.ozet} jsonld={[...konuJsonld(site, k), kirinti(site, kirintiOgeleri)]} gorsel={ogYolu(k)} tur="article" ilerleme>
  <article class="kap">
    <nav class="kirinti" aria-label="Konum">
      <ol>
        {kirintiOgeleri.slice(0, -1).map((o) => <li><a href={o.yol}>{o.ad}</a></li>)}
      </ol>
    </nav>

    <header class="konu-bas">
      <div class="rozetler">
        <span class="rozet vurgu">{k.sinav} · {k.ders}</span>
        <span class="rozet">{k.seviye}</span>
        <span class="rozet">{k.unite}</span>
        <span class="rozet">≈ {k.sure} dk</span>
      </div>
      <h1>{k.konu}<span class="h1-alt">{k.altBaslik}</span></h1>
      <p class="ozet"><Metin metin={k.ozet} terimler={adlar} /></p>
      <ol class="yol" aria-label="Bu derste">
        {bolumler.map((x) => <li><a href={`#${x.id}`}>{x.yol}</a></li>)}
      </ol>
    </header>

    <Bolum b={b.tahmin}><Tahmin client:visible {...k.tahmin} devam={{href: `#${b.gor.id}`, metin: 'Nasıl olduğunu gör ↓'}} /></Bolum>
    <Bolum b={b.gor}><Gorsel gorsel={k.gorsel} /></Bolum>
    <Bolum b={b.kural}><KuralKart kural={k.kural} /></Bolum>
    <Bolum b={b.neden}><NedenListe neden={k.neden} terimler={adlar} /></Bolum>
    <Bolum b={b.ornek}><Ornek client:visible {...k.ornek} /></Bolum>
    <Bolum b={b.hata}><HataKart hata={k.sikHata} terimler={adlar} /></Bolum>
    <Bolum b={b.kartlar}>
      <p class="ince">Kartı çevir, ne kadar bildiğini işaretle. Bilmediğin kartlar yakında tekrar gelir, bildiklerin daha seyrek.</p>
      <Kartlar client:visible konuId={k.id} kartlar={k.kartlar} />
    </Bolum>
    <Bolum b={b.sorular}><Sorular sorular={k.sorular} /></Bolum>

    <VideoKart k={k} />
    <DersSonu k={k} hepsi={hepsi} />
    <Kaynaklar k={k} />
  </article>
  <TerimPenceleri terimler={k.terimler} />
</Base>
