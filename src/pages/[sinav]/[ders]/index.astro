---
import Base from '../../../layouts/Base.astro';
import {DERSLER, SITE_ADI} from '../../../lib/site';
import {tumKonular} from '../../../lib/konular';
import {dersYolu, konuUrl, sinavYolu} from '../../../konu/yol';
import {kirinti} from '../../../lib/seo';
import type {Konu} from '../../../konu/schema';
import '../../../styles/hub.css';

// Yalnız en az bir konusu olan ders için sayfa üretilir (boş sayfa yok).
export async function getStaticPaths() {
  const hepsi = await tumKonular();
  const yollar = new Map<string, Konu[]>();
  for (const k of hepsi) {
    const a = `${k.sinav}/${k.dersSlug}`;
    yollar.set(a, [...(yollar.get(a) ?? []), k]);
  }
  return [...yollar.entries()].map(([a, konular]) => {
    const [sinav, ders] = a.split('/');
    return {params: {sinav: sinav.toLowerCase(), ders}, props: {sinav: sinav as 'TYT' | 'AYT', konular}};
  });
}
const {sinav, konular} = Astro.props;
const ders = DERSLER[sinav].find((d) => d.slug === konular[0].dersSlug)?.ad ?? konular[0].ders;
const uniteler = [...new Set(konular.map((k) => k.unite))];
const site = Astro.site!;
const yol = dersYolu(konular[0]);
---

<Base baslik={`${sinav} ${ders} konuları: anlatım, flash kart, çözümlü örnek | ${SITE_ADI}`} aciklama={`${sinav} ${ders} konuları: ${konular.map((k) => k.konu).join(', ')}. Her konu etkileşimli ders, çözümlü örnek ve flash kartlarla.`} jsonld={[kirinti(site, [{ad: SITE_ADI, yol: '/'}, {ad: sinav, yol: sinavYolu(sinav)}, {ad: `${sinav} ${ders}`, yol}])]}>
  <div class="kap genis">
    <nav class="kirinti" aria-label="Konum"><ol><li><a href="/">{SITE_ADI}</a></li><li><a href={sinavYolu(sinav)}>{sinav}</a></li></ol></nav>
    <header class="hub-bas">
      <span class="rozet vurgu">{sinav} · {ders}</span>
      <h1>{sinav} {ders} konuları</h1>
    </header>
    {uniteler.map((u) => (
      <section class="unite">
        <h2>{u}</h2>
        <div class="konu-liste">
          {konular.filter((k) => k.unite === u).map((k) => (
            <a class="konu-kart" href={konuUrl(k)}>
              <strong>{k.konu}</strong>
              <span class="vurgu-yazi">{k.altBaslik}</span>
              <span class="ince kucuk">{k.kartlar.length} flash kart · ≈ {k.sure} dk</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
