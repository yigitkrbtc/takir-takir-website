---
import Base from '../../layouts/Base.astro';
import {tumKonular} from '../../lib/konular';
import {dersYolu, sinavYolu} from '../../konu/yol';
import {DERSLER, SITE_ADI} from '../../lib/site';
import {kirinti} from '../../lib/seo';
import '../../styles/hub.css';

export function getStaticPaths() {
  return [{params: {sinav: 'tyt'}, props: {sinav: 'TYT' as const}}, {params: {sinav: 'ayt'}, props: {sinav: 'AYT' as const}}];
}
const {sinav} = Astro.props;
const konular = (await tumKonular()).filter((k) => k.sinav === sinav);
const say = (slug: string) => konular.filter((k) => k.dersSlug === slug).length;
const vaat = sinav === 'TYT' ? 'Temeli anla, karıştırdığını ayırt et, hızlı hatırla.' : 'Mantığını kavra, bağlantı kur, derinleş.';
const site = Astro.site!;
---

<Base noindex={konular.length === 0} baslik={`${sinav} konu anlatımı, flash kartlar ve çözümlü örnekler | ${SITE_ADI}`} aciklama={`${sinav} konuları etkileşimli derslerle: önce tahmin et, görselle anla, flash kartlarla tekrar et. ${vaat}`} jsonld={[kirinti(site, [{ad: SITE_ADI, yol: '/'}, {ad: sinav, yol: sinavYolu(sinav)}])]}>
  <div class="kap genis">
    <header class="hub-bas">
      <span class="rozet vurgu">{sinav}</span>
      <h1>{sinav} dersleri</h1>
      <p class="ince">{vaat}</p>
    </header>
    <div class="ders-izgara">
      {DERSLER[sinav].map((d) => {
        const n = say(d.slug);
        return n ? (
          <a class="ders-kart" href={dersYolu({sinav, dersSlug: d.slug})}><strong>{d.ad}</strong><span>{n} konu</span></a>
        ) : (
          <div class="ders-kart yakinda" aria-disabled="true"><strong>{d.ad}</strong><span>yakında</span></div>
        );
      })}
    </div>
  </div>
</Base>
